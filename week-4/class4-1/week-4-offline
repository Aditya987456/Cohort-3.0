//DELETE-----------------------------------removed unhealthy kidneys.

app.delete('/', (req,res)=>{
  if(unhealthy_hai()){

    let new_healthy=[];
    new_healthy=(users[0].kidneys.filter(ki=>ki.healthy) );

    users[0].kidneys=new_healthy;
    res.json({
      message:"successfully removed your unhealthy kidney"
    })



  }else{
    res.status(411).json({
      message:"you have no any unhealthy kidneys to remove!"
    })
  }


})





function unhealthy_hai(){

  for (let i = 0; i < users[0].kidneys.length; i++) {
    // if the kidney is unhealthy, return true
    if (!users[0].kidneys[i].healthy) {
        return true;
    }
}

// if there is no unhealthy kidney, return false
return false;



}





