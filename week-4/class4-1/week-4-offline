// ###  Creating an in memory hospital.................(kidney game--> get,post,put,delete)
app.use(express.json());

//GET----------------------------
const users=[{
  name:'Temba Bavuma',
  kidneys:[{healthy:true},{healthy:false}]

}];


app.get('/', (req,res)=>{

  const tembakid=users[0].kidneys;
    //res.json(tembakid)

  const num_of_kidneys=tembakid.length;
  const num_of_healthy=tembakid.filter( (kidneys)=>kidneys.healthy).length;
  const num_of_unhealthy=num_of_kidneys-num_of_healthy;

  res.json({
    num_of_kidneys,
    num_of_healthy,
    num_of_unhealthy
  });
})


//POST---------------------
app.post('/', (req,res)=>{

  //taking input--> 1. query se i.e /?n=16,   2. req.body.name.  i.e jo body me denge wo input lega.

  const wants_kidney=req.body.wants_kidney;    //$$ input from body

  users[0].kidneys.push({
    healthy:wants_kidney,
  })
  res.json({
    message:"succesfully added kidney..."
  });
})


//PUT--------------------------------------- replace unhealthy kidney with healthy kidney.
app.put('/', (req,res)=>{
  if(unhealthy_hai()){
  users[0].kidneys.filter((kidd)=>(!kidd.healthy)).map((kkid)=>kkid.healthy=true);


  res.json({
